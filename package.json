{
  "name": "laturaivo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "build:web": "rm -rf dist-web && VITE_LATURAIVO_WEB_RELEASE=1 vite build --outDir dist-web",
    "preview": "vite preview",
    "preview:web": "vite preview --outDir dist-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cap:init": "npx cap init LATURAIVO fi.ubercreative.laturaivo --web-dir dist",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync ios && npm run sync:ios-assets && npm run sync:ugames-sfx",
    "cap:open:ios": "open 'ios/App/Laturaivo.xcodeproj'",
    "sync:ios-assets": "mkdir -p ios/App/App/public && rsync -a --delete --delete-excluded --exclude='.DS_Store' dist/ ios/App/App/public/",
    "sync:ugames-sfx": "mkdir -p ios/App/App/public/assets/audio_local/ugames_sfx && rsync -a --delete --delete-excluded --exclude='.DS_Store' public/assets/audio_local/ugames_sfx/ ios/App/App/public/assets/audio_local/ugames_sfx/",
    "ios:build": "npm run cap:sync",
    "ios:open": "npm run ios:build && npm run cap:open:ios",
    "ios:xcode:show-settings": "DEVELOPER_DIR='/Applications/Xcode.app/Contents/Developer' xcodebuild -project 'ios/App/Laturaivo.xcodeproj' -scheme 'Laturaivo' -showBuildSettings",
    "ios:xcode:build:sim": "DEVELOPER_DIR='/Applications/Xcode.app/Contents/Developer' xcodebuild -project 'ios/App/Laturaivo.xcodeproj' -scheme 'Laturaivo' -configuration Debug -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "ios:xcode:archive": "DEVELOPER_DIR='/Applications/Xcode.app/Contents/Developer' xcodebuild -project 'ios/App/Laturaivo.xcodeproj' -scheme 'Laturaivo' -configuration Release -destination 'generic/platform=iOS' -archivePath 'build/archives/Laturaivo.xcarchive' archive"
  },
  "dependencies": {
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "@supabase/supabase-js": "^2.89.0",
    "phaser": "3.90.0",
    "phaser3-rex-plugins": "^1.80.17"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "canvas": "^3.2.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.3",
    "vite": "^6.2.6",
    "vitest": "^3.2.4"
  }
}
